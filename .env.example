APP_NAME="Notification Dispatcher"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=notification_dispatcher
DB_USERNAME=dispatcher_user
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=notification_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Notification System Settings
# Webhook URL for testing notifications (use webhook.site for development)
NOTIFICATION_WEBHOOK_URL=https://webhook.site/your-unique-uuid

# Provider HTTP Settings
# Timeout for HTTP requests to notification providers (seconds)
NOTIFICATION_PROVIDER_TIMEOUT=30
# Number of retry attempts for failed HTTP requests
NOTIFICATION_PROVIDER_RETRY=2
# Delay between HTTP retries (milliseconds)
NOTIFICATION_PROVIDER_RETRY_DELAY=100

# Queue Retry Configuration
# Maximum number of job retry attempts before moving to dead letter queue
NOTIFICATION_MAX_ATTEMPTS=5
# Backoff strategy (seconds): wait time between each retry attempt
NOTIFICATION_BACKOFF_1=60     # 1st retry: 1 minute
NOTIFICATION_BACKOFF_2=300    # 2nd retry: 5 minutes
NOTIFICATION_BACKOFF_3=1800   # 3rd retry: 30 minutes
NOTIFICATION_BACKOFF_4=7200   # 4th retry: 2 hours

# Rate Limiting
# Enable/disable rate limiting per channel
RATE_LIMIT_ENABLED=true
# Requests per second per channel
RATE_LIMIT_RPS=100

# Circuit Breaker
# Enable/disable circuit breaker for provider failures
CIRCUIT_BREAKER_ENABLED=true
# Number of consecutive failures before opening circuit
CIRCUIT_BREAKER_THRESHOLD=5
# Recovery time before attempting to close circuit (seconds)
CIRCUIT_BREAKER_TIMEOUT=30

# RabbitMQ Configuration (Message Broker)
QUEUE_CONNECTION=rabbitmq
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=notification
RABBITMQ_PASSWORD=secret
RABBITMQ_VHOST=notifications
RABBITMQ_QUEUE=notifications
RABBITMQ_EXCHANGE=notifications
RABBITMQ_EXCHANGE_TYPE=direct

# Distributed Tracing (OpenTelemetry + Jaeger)
# Enable/disable distributed tracing
TRACING_ENABLED=false
# Service name in tracing system
TRACING_SERVICE_NAME=notification-dispatcher
# OTLP endpoint (Jaeger)
TRACING_ENDPOINT=http://jaeger:4318
# Sample rate (0.0 to 1.0): 1.0 = trace all requests
TRACING_SAMPLE_RATE=1.0
# Instrument HTTP requests
TRACING_INSTRUMENT_HTTP=true
# Instrument queue jobs
TRACING_INSTRUMENT_QUEUE=true
# Instrument database queries (high overhead)
TRACING_INSTRUMENT_DATABASE=false
# Instrument cache operations (high overhead)
TRACING_INSTRUMENT_CACHE=false

# Laravel Reverb (WebSocket Server)
REVERB_APP_ID=notification-dispatcher
REVERB_APP_KEY=reverb-key
REVERB_APP_SECRET=reverb-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
